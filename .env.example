# Backend API base URL (no trailing slash)
# Dev:  http://localhost:3000
# Prod: https://api.echobyreaclyse.com
VITE_API_URL=https://api.echobyreaclyse.com

# Meta Pixel ID (from Meta Events Manager)
VITE_META_PIXEL_ID=

# Google OAuth client ID (from Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=

# Apple Sign In (from Apple Developer → Certificates, Identifiers & Profiles → Services IDs)
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://echobyreaclyse.com/admin/login
