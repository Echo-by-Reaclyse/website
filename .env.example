# Backend API base URL (no trailing slash)
# Dev:  http://localhost:3000
# Prod: https://api.echobyreaclyse.com
VITE_API_URL=https://api.echobyreaclyse.com

# Meta Pixel ID (from Meta Events Manager → Data Sources)
VITE_META_PIXEL_ID=

# Meta Conversions API access token (server-side only — set in Vercel env vars, NOT prefixed with VITE_)
# Generate at: Meta Events Manager → Data Sources → your pixel → Settings → Conversions API → Generate access token
META_CAPI_TOKEN=

# Google Analytics 4 Measurement ID (from GA4 → Admin → Data Streams → your stream)
VITE_GA4_ID=

# Google OAuth client ID (from Google Cloud Console → Credentials)
VITE_GOOGLE_CLIENT_ID=

# Apple Sign In (from Apple Developer → Certificates, Identifiers & Profiles → Services IDs)
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=https://echobyreaclyse.com/admin/login
